---
// Custom Footer override. Composes Starlight's default footer
// (pagination, LastUpdated, EditLink) and appends the generation block
// naming the revision these pages were built from.
//
// The values are compile-time constants resolved in `astro.config.mjs`
// — injected by the deploy, otherwise derived from git. There is
// deliberately no fallback here: a build that cannot name its revision
// fails in the config with an explanation, rather than reaching this
// component and rendering a word like `unbuilt` that reads as data.
import Default from "@astrojs/starlight/components/Footer.astro";

declare const __GENERATION_SHA__: string;
declare const __GENERATION_DATE__: string;

const sha = __GENERATION_SHA__;
const date = __GENERATION_DATE__;
---

<Default><slot /></Default>

<p class="generation-footer" data-generation-sha={sha} data-generation-date={date}>
  Generated from
  <code>{sha}</code>
  on
  <code>{date}</code>
</p>

<style>
  .generation-footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .generation-footer code {
    font-size: inherit;
    background: var(--sl-color-gray-6);
    padding: 0.1em 0.4em;
    border-radius: 0.2em;
  }
</style>
