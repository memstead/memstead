#!/bin/sh
# Local denylist scan at push time.
#
# A maintainer may keep a private list of words that must never reach this
# repository's remote (names, subjects, anything a neutral tool should not
# carry). When such a list exists, every pushed tip is scanned against it
# and a hit refuses the push, because a push is not retractable. Without a
# list this hook does nothing, so a fresh clone is unaffected.
#
# The list is one extended regular expression per line (`#` comments and
# blank lines ignored; a `w:` prefix makes the line a whole-word match),
# matched case-insensitively against every tracked
# text file of the pushed commit. It is looked up, in order:
#   1. $MEMSTEAD_DENYLIST (a file path)
#   2. ../scripts/neutrality-denylist.txt relative to this repository's root
#      (the layout where this repository is a submodule of a private one)
#   * MEMSTEAD_SKIP_DENYLIST=1 bypasses the scan (reported).
#
# Armed per clone by setting core.hooksPath to .githooks.
set -u
ZERO=0000000000000000000000000000000000000000
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
list="${MEMSTEAD_DENYLIST:-}"
[ -n "$list" ] || list="$root/../scripts/neutrality-denylist.txt"
[ -f "$list" ] || exit 0
if [ "${MEMSTEAD_SKIP_DENYLIST:-0}" = "1" ]; then
  echo "pre-push: MEMSTEAD_SKIP_DENYLIST=1, denylist scan skipped" >&2
  exit 0
fi
patterns="$(mktemp)"; words="$(mktemp)"
trap 'rm -f "$patterns" "$words"' EXIT
grep -vE '^[[:space:]]*(#|$)' "$list" | grep -v '^w:' > "$patterns"
grep -E '^w:' "$list" | sed 's/^w://' > "$words"
[ -s "$patterns" ] || [ -s "$words" ] || exit 0
refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue
  out="$( { [ -s "$patterns" ] && git grep -nIiE -f "$patterns" "$local_sha" -- . 2>/dev/null
            [ -s "$words" ] && git grep -nIiwE -f "$words" "$local_sha" -- . 2>/dev/null; } | sort -u)"
  # Binary files are skipped above, and a sealed archive is a zip: unpack
  # every tracked `.mem` / `.zip` of the pushed commit and scan its members.
  for arc in $(git ls-tree -r --name-only "$local_sha" 2>/dev/null | grep -E '\.(mem|zip)$'); do
    tmp="$(mktemp)"
    git cat-file -p "$local_sha:$arc" > "$tmp" 2>/dev/null
    hits="$( { [ -s "$patterns" ] && unzip -p "$tmp" 2>/dev/null | grep -aIiE -f "$patterns"
               [ -s "$words" ] && unzip -p "$tmp" 2>/dev/null | grep -aIiwE -f "$words"; } | sort -u | sed "s|^|$arc (inside): |")"
    rm -f "$tmp"
    [ -n "$hits" ] && out="$out
$hits"
  done
  if [ -n "$out" ]; then
    echo "pre-push: REFUSED, $local_ref carries words from the local denylist:" >&2
    printf '%s\n' "$out" | cut -c1-200 >&2
    echo "  Reword, commit, push again. Deliberate exception: MEMSTEAD_SKIP_DENYLIST=1 git push ..." >&2
    refused=1
  fi
done
exit $refused
